---
---
[
{% assign search_items = site.materials | concat: site.posts %}
{% for item in search_items %}
  {
    "title": {{ item.title | jsonify }},
    "kind": {{ item.kind | jsonify }},
    "url": {{ item.url | jsonify }},
    "date": {{ item.date | date: "%Y-%m-%d" | jsonify }},
    "text": {{ item.content | strip_html | normalize_whitespace | replace: "&amp;", "&" | replace: "&nbsp;", " " | truncate: 800 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
